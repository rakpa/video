# --- VidCliply backend configuration ---



# Port the API listens on

PORT=3081



# Allowed CORS origin(s) — comma-separated for multiple (e.g. Vercel + custom domain)

CLIENT_ORIGIN=http://localhost:3080



# Public site URL for Stripe success/cancel redirects (no trailing slash)

SITE_URL=http://localhost:3080



# Paths to the external binaries. Leave as-is if they are on your PATH.

YTDLP_PATH=yt-dlp

FFMPEG_PATH=ffmpeg



# --- Capacity (Railway Hobby 8 GB / 8 vCPU) — auto-scales if omitted ---

# MAX_CONCURRENT_JOBS=12

# MAX_CONCURRENT_HIGH_RES_JOBS=6

# MAX_CONCURRENT_TRANSCODES=3

# MAX_CONCURRENT_JOBS_PER_IP=3

# LOW_MEMORY_MODE=false

# NODE_OPTIONS=--max-old-space-size=1024



# YouTube on cloud hosts (Render/AWS): optional cookies + PO token for yt-dlp.

# Cookies: Netscape cookies.txt path (Render Secret File → /etc/secrets/cookies.txt)

# YTDLP_COOKIES=/etc/secrets/cookies.txt

# PO token: full yt-dlp po_token value, e.g. mweb.gvs.YOUR_TOKEN (see PO Token Guide)

# YTDLP_PO_TOKEN=mweb.gvs.YOUR_TOKEN

# Player client when using PO token (default: mweb)

# YTDLP_PLAYER_CLIENT=mweb



# How long a finished temp file survives before the sweeper removes it

TMP_TTL_MINUTES=30



# Reject videos longer than this many minutes (abuse / disk guard)

MAX_DURATION_MINUTES=180



# --- Monetisation / Stripe ---

# Resolutions at or below this height are free without a paid plan (1080p HD default).
FREE_MAX_HEIGHT=1080

# Owner/testing emails with unlimited quality (comma-separated).
ADMIN_EMAILS=rakpa8@gmail.com

# Stripe keys — NEVER commit real keys. Copy this file to .env and fill in locally.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Pro yearly price in cents ($19.99/year — unlocks 2K & 4K).
PRICE_PRO_YEARLY_CENTS=1999
PRICE_YEARLY_CENTS=1999



# Secret to sign Pro license tokens — set to a long random string in production.

LICENSE_SECRET=change-me-to-a-long-random-string

# Admin token for viewing download stats (/api/admin/stats)
ADMIN_TOKEN=change-this-to-a-strong-secret-token
