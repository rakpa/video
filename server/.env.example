# --- ClipVault backend configuration ---

# Port the API listens on
PORT=3081

# Allowed CORS origin (your frontend dev server)
CLIENT_ORIGIN=http://localhost:3080

# Paths to the external binaries. Leave as-is if they are on your PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# How long a finished temp file survives before the sweeper removes it
TMP_TTL_MINUTES=30

# Reject videos longer than this many minutes (abuse / disk guard)
MAX_DURATION_MINUTES=180

# --- Monetisation / Stripe ---
# Resolutions at or below this height are free; above requires Pro.
# 1080 → 720p & 1080p free; 2K (1440p) & 4K (2160p) are Pro.
FREE_MAX_HEIGHT=1080

# Stripe keys (test mode is fine). Leave blank to disable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Prices in cents. Monthly $5.99, Lifetime $9.00 (test).
PRICE_MONTHLY_CENTS=599
PRICE_LIFETIME_CENTS=900

# Secret to sign Pro license tokens — set to a long random string in production.
LICENSE_SECRET=change-me-to-a-long-random-string
